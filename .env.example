# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/secure_voting
# Development-only option: runs a temporary embedded MongoDB and needs no local installation.
USE_IN_MEMORY_DB=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
OTP_PEPPER=replace-with-a-separate-random-secret
BALLOT_ENCRYPTION_KEY=replace-with-64-hex-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SecureVote <noreply@securevote.local>
ALLOW_DEV_OTP=true
ADMIN_EMAIL=admin@securevote.local
ADMIN_PASSWORD=ChangeMe123!

# Blockchain (server and client)
RPC_URL=http://127.0.0.1:8545
VOTING_CONTRACT_ADDRESS=
CHAIN_ID=31338
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=
VITE_API_URL=http://localhost:4000/api
VITE_CHAIN_ID=31338
VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=http://127.0.0.1:8545

